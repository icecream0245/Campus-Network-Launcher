# 虚拟环境与构建产物
/.venv/
/build/
/dist/
/logs/
*.spec.bak

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 本地配置（含账号凭据，切勿提交）
/config.yml
/src/config.json
/config.json

# 编辑器
/.idea/
/.vscode/

# 临时目录（部分环境下 TMP 指向当前目录）
/eporta-e2e-*/
/pytest-of-*/
/pip-*/
/.tmp/

# 认证页侦察脚本的产物
/eporta_probe/

# 界面预览图（含本机账号信息，不提交）
/ui-preview*.png
/.screenshot.png

# 提交信息临时文件
/.commit-msg.txt

# 配置备份（含账号信息，绝不提交）
/backups/
